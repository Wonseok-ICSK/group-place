[Unit]
Description=group-place database and Storage backup
After=network-online.target
[Service]
Type=oneshot
User=root
Group=ourplaces
EnvironmentFile=/etc/our-places/env
EnvironmentFile=/etc/our-places/secret.env
EnvironmentFile=-/etc/our-places/backup.env
ExecStart=/usr/bin/flock -w 600 /run/lock/our-places-data.lock /usr/bin/node /srv/our-places/current/deploy/home/maintenance.cjs backup
StateDirectory=our-places-jobs
StateDirectoryMode=0750
UMask=0077
ReadWritePaths=/var/backups/group-place /run/lock
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
TimeoutStartSec=30min
[Install]
WantedBy=multi-user.target
